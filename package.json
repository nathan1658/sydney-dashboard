{
  "name": "sydney-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Realtime 3D city dashboard for Sydney built on open government data (BoM, Transport for NSW).",
  "license": "MIT",
  "engines": {},
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc && tsc -p server",
    "deploy:api": "wrangler deploy",
    "deploy:web": "vite build && firebase deploy --only hosting",
    "deploy": "npm run deploy:api && npm run deploy:web"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "@loaders.gl/core": "4.5.2",
    "@loaders.gl/images": "4.5.2",
    "@loaders.gl/schema": "4.5.1",
    "@loaders.gl/loader-utils": "4.5.2",
    "@loaders.gl/schema-utils": "4.5.2",
    "@loaders.gl/worker-utils": "4.5.2"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "fast-xml-parser": "^5.11.2",
    "gtfs-realtime-bindings": "^2.2.0",
    "maplibre-gl": "^6.13.0"
  }
}
